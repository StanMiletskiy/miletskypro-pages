d:["$","section",null,{"className":"cv-section","children":[["$","h2",null,{"children":"Experience"}],["$","div",null,{"className":"cv-copy","children":[["$","article",null,{"className":"company","children":[["$","header",null,{"className":"company-header","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Feb 2022 — present · contract · remote"}],["$","h3",null,{"children":"SETRONICA"}]]}],["$","p",null,{"children":"Concurrent technical assignments within a digital agency — one long-running engagement, not a sequence of company changes."}]]}],["$","div",null,{"className":"assignments","children":[["$","article","AI / LLM Project Manager",{"className":"assignment","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Feb 2025 — present"}],["$","h4",null,{"children":"AI / LLM Project Manager"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Manage international RLHF and LLM-optimization delivery with a core team of 8 software engineers, scaling with 20+ contributors for larger batches. Coordinate dataset production across response evaluation, coding, testing, MCP and agentic workflows."}],["$","p",null,{"className":"assignment-result","children":"Improved tracked model-quality metrics by ~15%, reduced time-to-production by 20–30%, and delivered 95%+ of projects on time without rework."}]]}]]}],["$","article","Release Manager",{"className":"assignment","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Dec 2022 — Sep 2024"}],["$","h4",null,{"children":"Release Manager"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Owned production releases three times per week for a high-load Saudi food-delivery and mobility platform. Aligned Operations, Payments, Wallet, Merchant Integrations and BI through a cross-team calendar, dependency review and live go/no-go decisions."}],["$","p",null,{"className":"assignment-result","children":"Cut automated test cycles from ~25 to 14 minutes, brought releases reliably inside the four-hour window, reduced release incidents by ~60%, and lowered Change Failure Rate from ~25% to 10–12%."}]]}]]}],["$","article","IT Project Manager — Logistics",{"className":"assignment","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Sep 2024 — Feb 2025"}],["$","h4",null,{"children":"IT Project Manager — Logistics"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Led a cross-functional team of 10 and owned Scrum delivery for multi-stop routing, combined deliveries, dynamic assignment, driver balancing, balance withdrawals and payment-gateway improvements."}],["$","p",null,{"className":"assignment-result","children":"Reduced logistics costs by up to 18% and customer wait time by ~25%, measured through operational analytics."}]]}]]}],["$","article","DevOps Delivery Manager",{"className":"assignment","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Feb 2022 — Dec 2023"}],["$","h4",null,{"children":"DevOps Delivery Manager"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Coordinated 12 DevOps engineers and 2 DBAs supporting an AWS-based platform handling ~80,000 daily orders and peaks above 100,000. Managed backlog, blockers, PagerDuty rotations, RCA follow-through and cross-team delivery."}],["$","p",null,{"className":"assignment-result","children":"Helped the team sustain >99.95% availability, reduce MTTR by ~40%, and lower infrastructure costs by ~15% through collaborative reliability and scaling initiatives."}]]}]]}],["$","article","Support Team Manager",{"className":"assignment","children":[["$","div",null,{"children":[["$","p",null,{"className":"date","children":"Nov 2023 — present"}],["$","h4",null,{"children":"Support Team Manager"}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Manage two service desks supporting ~250 users across ThinkWell and SETRONICA, covering Jira Service