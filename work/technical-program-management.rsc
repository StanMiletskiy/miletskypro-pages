1:["$","main",null,{"className":"case-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Connecting technical work, operational risk and business outcomes.\",\"author\":{\"@id\":\"https://miletsky.pro/#person\"},\"about\":[\"Technical program management\",\"DevOps and infrastructure delivery\",\"Operational technology programs\",\"Risk, dependencies and stakeholder alignment\",\"Incident management and RCA follow-through\"],\"inLanguage\":\"en\"}"}}],["$","nav",null,{"className":"case-nav","aria-label":"Case study navigation","children":[["$","$L6",null,{"href":"/cv/","children":"← Back to CV"}],["$","$L6",null,{"href":"/","children":"Back to doomscrolling"}]]}],["$","header",null,{"className":"case-hero","children":[["$","p",null,{"className":"cv-kicker","children":"Technical program management"}],["$","h1",null,{"children":"Connecting technical work, operational risk and business outcomes."}],["$","p",null,{"children":"My technical program-management work sits between specialist teams and business operations. I establish priorities, dependencies, decision points and feedback loops so complex initiatives can move across engineering, infrastructure and operational boundaries."}]]}],["$","section",null,{"className":"case-metrics","aria-label":"Selected outcomes","children":[["$","article","platform availability supported by the DevOps team",{"children":[["$","strong",null,{"children":">99.95%"}],["$","span",null,{"children":"platform availability supported by the DevOps team"}]]}],["$","article","reduction in MTTR",{"children":[["$","strong",null,{"children":"~40%"}],["$","span",null,{"children":"reduction in MTTR"}]]}],["$","article","reduction in logistics costs",{"children":[["$","strong",null,{"children":"up to 18%"}],["$","span",null,{"children":"reduction in logistics costs"}]]}]]}],["$","div",null,{"className":"case-body","children":[["$","section","High-load infrastructure delivery",{"children":[["$","h2",null,{"children":"High-load infrastructure delivery"}],["$","div",null,{"children":[["$","p","I coordinated twelve DevOps engineers and two DBAs supporting an AWS platform handling approximately 80,000 orders per day, more than 100,000 on peak evenings and 600,000–800,000 users. I managed the backlog, priorities, blockers, adjacent-team coordination and reporting to the Head of DevOps.",{"children":"I coordinated twelve DevOps engineers and two DBAs supporting an AWS platform handling approximately 80,000 orders per day, more than 100,000 on peak evenings and 600,000–800,000 users. I managed the backlog, priorities, blockers, adjacent-team coordination and reporting to the Head of DevOps."}],["$","p","I also owned PagerDuty rotations and on-call onboarding, kept root-cause actions from stalling, and ensured reliability improvements reached delivery sprints. Collaborative team outcomes included availability above 99.95%, approximately 40% lower MTTR and approximately 15% infrastructure cost savings.",{"children":"I also owned PagerDuty rotations and on-call onboarding, kept root-cause actions from stalling, and ensured reliability improvements reached delivery sprints. Collaborative team outcomes included availability above 99.95%, approximately 40% lower MTTR and approximately 15% infrastructure cost savings."}]]}]]}],["$","section","Operational product delivery",{"children":[["$","h2",null,{"children":"Operational product delivery"}],["$","div",null,{"children":[["$","p","As the sole Project Manager in a ten-person logistics technology team, I owned Scrum delivery across backend, frontend, systems analysis and product. The team delivered multi-stop routing, combined deliveries, dynamic order assignment and real-time balancing based on driver availability.",{"children":"As the sole Project Manager in a ten-person logistics technology team, I owned Scrum delivery across backend, frontend, systems analysis and product. The team delivered multi-stop routing, combined deliveries, dynamic order assignment and real-time balancing based on driver availability."}],"$L7"]}]]}],"$L8"]}],"$L9","$La"]}]
7:["$","p","Operational analytics showed logistics costs reduced by up to 18% and customer wait time reduced by approximately 25%. The useful program-management lesson was to connect the engineering roadmap to observable operational measures, not only output milestones.",{"children":"Operational analytics showed logistics costs reduced by up to 18% and customer wait time reduced by approximately 25%. The useful program-management lesson was to connect the engineering roadmap to observable operational measures, not only output milestones."}]
8:["$","section","How I lead technical programs",{"children":[["$","h2",null,{"children":"How I lead technical programs"}],["$","div",null,{"children":[["$","p","I do not replace technical leads or claim engineering implementations as my own. I create a delivery environment in which experts can make good decisions: explicit priorities, visible dependencies, clear ownership, timely escalation and metrics connected to business impact.",{"children":"I do not replace technical leads or claim engineering implementations as my own. I create a delivery environment in which experts can make good decisions: explicit priorities, visible dependencies, clear ownership, timely escalation and metrics connected to business impact."}],["$","p","This approach has transferred across infrastructure, releases, logistics, AI delivery and service operations. The domain changes; the core work of turning ambiguity into a system teams can run remains consistent.",{"children":"This approach has transferred across infrastructure, releases, logistics, AI delivery and service operations. The domain changes; the core work of turning ambiguity into a system teams can run remains consistent."}]]}]]}]
9:["$","section",null,{"className":"case-capabilities","children":[["$","p",null,{"className":"cv-kicker","children":"Relevant capabilities"}],["$","ul",null,{"children":[["$","li","Technical program management",{"children":"Technical program management"}],["$","li","DevOps and infrastructure delivery",{"children":"DevOps and infrastructure delivery"}],["$","li","Operational technology programs",{"children":"Operational technology programs"}],["$","li","Risk, dependencies and stakeholder alignment",{"children":"Risk, dependencies and stakeholder alignment"}],["$","li","Incident management and RCA follow-through",{"children":"Incident management and RCA follow-through"}]]}]]}]
