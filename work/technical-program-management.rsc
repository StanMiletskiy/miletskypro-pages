":"Stanislav Miletsky — Technical Project & Delivery Manager"}],["$","meta","4",{"property":"og:description","content":"15+ years across AI/LLM, high-load platforms, release management, DevOps and international delivery."}],["$","meta","5",{"property":"og:url","content":"https://miletsky.pro"}],["$","meta","6",{"property":"og:type","content":"profile"}],["$","meta","7",{"property":"og:image","content":"https://miletsky.pro/og.png"}],["$","meta","8",{"property":"og:image:width","content":"1200"}],["$","meta","9",{"property":"og:image:height","content":"630"}],["$","meta","10",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","11",{"name":"twitter:title","content":"Stanislav Miletsky — Technical Project & Delivery Manager"}],["$","meta","12",{"name":"twitter:description","content":"15+ years across AI/LLM, high-load platforms, release management, DevOps and international delivery."}],["$","meta","13",{"name":"twitter:image","content":"https://miletsky.pro/og.png"}],["$","link","14",{"rel":"shortcut icon","href":"https://miletsky.pro/favicon.svg"}],["$","link","15",{"rel":"icon","href":"https://miletsky.pro/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://miletsky.pro/work/technical-program-management"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["work","technical-program-management"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/work/technical-program-management/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1q8yrgk128gtg","deploymentVersion":"b80e0af8-e7c9-42a8-afca-2033b1c4a51b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
