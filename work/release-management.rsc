1:["$","main",null,{"className":"case-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Making high-risk releases predictable across tightly coupled teams.\",\"author\":{\"@id\":\"https://miletsky.pro/#person\"},\"about\":[\"Release strategy and governance\",\"Go/no-go and rollback decisions\",\"Cross-team dependency management\",\"DORA metrics and Change Failure Rate\",\"High-load production systems\"],\"inLanguage\":\"en\"}"}}],["$","nav",null,{"className":"case-nav","aria-label":"Case study navigation","children":[["$","$L6",null,{"href":"/cv/","children":"← Back to CV"}],["$","$L6",null,{"href":"/","children":"Back to doomscrolling"}]]}],["$","header",null,{"className":"case-hero","children":[["$","p",null,{"className":"cv-kicker","children":"Release management"}],["$","h1",null,{"children":"Making high-risk releases predictable across tightly coupled teams."}],["$","p",null,{"children":"For a high-load food-delivery and mobility platform, production releases involved tightly coupled services, multiple business domains and real-time decisions. I built a shared release operating model that reduced conflicts, shortened feedback cycles and made the deployment window dependable."}]]}],["$","section",null,{"className":"case-metrics","aria-label":"Selected outcomes","children":[["$","article","fewer release-related incidents",{"children":[["$","strong",null,{"children":"~60%"}],["$","span",null,{"children":"fewer release-related incidents"}]]}],["$","article","Change Failure Rate, down from approximately 25%",{"children":[["$","strong",null,{"children":"10–12%"}],["$","span",null,{"children":"Change Failure Rate, down from approximately 25%"}]]}],["$","article","automated test cycle, down from approximately 25 minutes",{"children":[["$","strong",null,{"children":"14 min"}],["$","span",null,{"children":"automated test cycle, down from approximately 25 minutes"}]]}]]}],["$","div",null,{"className":"case-body","children":[["$","section","Context",{"children":[["$","h2",null,{"children":"Context"}],["$","div",null,{"children":[["$","p","From December 2022 to September 2024, I owned production releases three days per week for a confidential Saudi platform supporting food delivery and mobility. Thursday and Friday were peak-order days, so the standard release schedule deliberately protected those periods.",{"children":"From December 2022 to September 2024, I owned production releases three days per week for a confidential Saudi platform supporting food delivery and mobility. Thursday and Friday were peak-order days, so the standard release schedule deliberately protected those periods."}],["$","p","Operations, Payments, Wallet, Merchant Integrations and BI shared dependencies across a monolith transitioning toward microservices. Each release ran in three or four deployment waves with automated tests between waves, and delays could push work beyond the four-hour window.",{"children":"Operations, Payments, Wallet, Merchant Integrations and BI shared dependencies across a monolith transitioning toward microservices. Each release ran in three or four deployment waves with automated tests between waves, and delays could push work beyond the four-hour window."}]]}]]}],["$","section","Release operating model",{"children":[["$","h2",null,{"children":"Release operating model"}],["$","div",null,{"children":[["$","p","I introduced a cross-team release calendar, dependency review and detailed planning before the release window. This gave service owners one view of sequencing and conflicts instead of discovering dependencies during production deployment.",{"children":"I introduced a cross-team release calendar, dependency review and detailed planning before the release window. This gave service owners one view of sequencing and conflicts instead of discovering dependencies during production deployment."}],"$L7"]}]]}],"$L8"]}],"$L9","$La"]}]
7:["$","p","During releases, I owned the go/no-go process and coordinated rollback-versus-hotfix decisions with on-call DevOps and engineering. Analysis showed automated testing was the main bottleneck, so the team focused improvement work there and reduced the test cycle from approximately 25 minutes to 14 minutes.",{"children":"During releases, I owned the go/no-go process and coordinated rollback-versus-hotfix decisions with on-call DevOps and engineering. Analysis showed automated testing was the main bottleneck, so the team focused improvement work there and reduced the test cycle from approximately 25 minutes to 14 minutes."}]
8:["$","section","Outcome",{"children":[["$","h2",null,{"children":"Outcome"}],["$","div",null,{"children":[["$","p","Releases that frequently exceeded the 08:00–12:00 window became predictable and generally finished between 08:00 and 11:30. Release-related incidents fell by approximately 60%, while Change Failure Rate dropped from approximately 25% to 10–12%.",{"children":"Releases that frequently exceeded the 08:00–12:00 window became predictable and generally finished between 08:00 and 11:30. Release-related incidents fell by approximately 60%, while Change Failure Rate dropped from approximately 25% to 10–12%."}],["$","p","The improvement did not come from adding ceremony. It came from making dependencies, decision rights, test feedback and production risk visible at the right time.",{"children":"The improvement did not come from adding ceremony. It came from making dependencies, decision rights, test feedback and production risk visible at the right time."}]]}]]}]
9:["$","section",null,{"className":"case-capabilities","children":[["$","p",null,{"className":"cv-kicker","children":"Relevant capabilities"}],["$","ul",null,{"children":[["$","li","Release strategy and governance",{"children":"Release strategy and governance"}],["$","li","Go/no-go and rollback decisions",{"children":"Go/no-go and rollback decisions"}],["$","li","Cross-team dependency management",{"children":"Cross-team dependency management"}],["$","li","DORA metrics and Change Failure Rate",{"children":"DORA metrics and Change Failure Rate"}],["$","li","High-load production systems",{"children":"High-load production systems"}]]}]]}]
